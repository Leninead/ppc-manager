# secrets.toml.example — PLANTILLA con credenciales DUMMY.
#
# Para usar en local:
#   1. Copiá este archivo a `.streamlit/secrets.toml` (sin el .example).
#   2. Reemplazá el placeholder de `password` por un hash bcrypt real.
#      Generalo corriendo:  python gen_secrets.py
#   3. Cambiá `cookie.key` por un string aleatorio largo (cualquiera, único).
#
# El `secrets.toml` real está gitignored — NUNCA lo commitees.
# Alternativa sin secrets: corré la app con la variable de entorno
#   AGENCY_OS_LOCAL_MODE=1   (desactiva el login — solo para soak local).

[credentials.usernames.demo]
email = "demo@example.com"
name = "Demo User"
# NO es un hash válido — regeneralo con gen_secrets.py antes de usar:
password = "GENERAR_CON_gen_secrets.py"

[cookie]
name = "agency_os_auth"
key = "REEMPLAZAR_POR_STRING_ALEATORIO_LARGO"
expiry_days = 30

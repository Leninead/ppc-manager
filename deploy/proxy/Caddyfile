# APP_DOMAIN → the site (subdomain, or :80 for HTTP-on-IP). ACME_EMAIL → Let's Encrypt.
# Caddy auto-HTTPS: internal CA for local names, Let's Encrypt for a public domain.
{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip
    # Access log to stdout (docker logs caddy) — request trail for incident diagnosis.
    log {
        format json
    }

    # Path splitting: everything under /oauth/ and /notifications reaches the
    # integrations receiver (see services/integrations_receiver/). The rest of
    # the domain stays on Streamlit — the receiver never learns which page the
    # user was on, and Streamlit never sees an OAuth code.
    #
    # Order matters in Caddy: the FIRST matching handler wins. `handle` blocks
    # here are mutually exclusive by design, no fallthrough surprises.
    handle /oauth/* {
        reverse_proxy integrations-receiver:8600 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
    handle /notifications {
        reverse_proxy integrations-receiver:8600 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
    handle {
        reverse_proxy app:8501 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

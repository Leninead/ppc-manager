{
  "display_information": {
    "name": "capybara",
    "description": "El chat de PPC Manager en Slack: preguntale por los clientes y sus cuentas de Amazon Ads.",
    "background_color": "#E84000"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "capyassistant",
      "always_online": true
    },
    "assistant_view": {
      "assistant_description": "Preguntale por los clientes de la agencia y sus cuentas de Amazon Ads. Responde con los mismos datos y herramientas que el chat de PPC Manager."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "assistant_thread_context_changed",
        "assistant_thread_started",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_hosted": false,
    "token_rotation_enabled": false
  }
}
